{
  "name": "codex-anywhere",
  "version": "0.0.1",
  "files": [
    "README.md",
    "scratch/asar/**/*",
    "src/server/**/*.js",
    "src/server/electron/index.js",
    "!**/*.ts"
  ],
  "bin": "src/server/main.js",
  "scripts": {
    "prepare": "./scripts/prepare && npm run build:browser && npm run build:webview-dist && npm run build:server",
    "build": "npm run prepare:asar && npm run build:browser && npm run build:webview-dist && npm run build:server",
    "launch:unpacked:server": "http-server ./scratch/asar/webview -a localhost -p 5175 -c-1",
    "launch:unpacked": "NODE_ENV=development electron ./scratch/asar --remote-debugging-port=9222",
    "dev:browser": "vite --config vite.browser.config.ts",
    "build:browser": "vite build --config vite.browser.config.ts",
    "build:server": "cd src/server && tsc",
    "prepare:asar": "./scripts/prepare_asar",
    "preserver": "npm run build:server && npm run build:browser && npm run build:webview-dist",
    "server": "CODEX_CLI_PATH=$(which codex) node src/server/main.js",
    "build:webview-dist": "node scripts/optimize_webview.mjs",
    "test:auth": "npm run build:server && node --test test/device-auth.test.mjs test/plugin-sandbox.test.mjs test/device-gate-server.test.mjs"
  },
  "repository": "github:hristo2612/codex-anywhere",
  "author": "martin <martincharles07@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@electron/asar": "^4.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.1",
    "@tanstack/react-query": "^5.100.9",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.9.0",
    "fastify": "^5.8.5",
    "glob": "^13.0.6",
    "prettier": "^3.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp-cli": "^5.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "41.2.0",
    "esbuild": "0.28.2",
    "http-server": "^14.1.1"
  }
}
