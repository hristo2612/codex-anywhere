// Build settings for a fresh checkout. Signing and the server address are
// yours to set: copy Local.xcconfig.example to Local.xcconfig (gitignored).
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = com.example.codexanywhere
// The server the app opens on first launch. Empty: the app asks for it.
CODEX_ANYWHERE_SERVER_URL =
// Home-screen name and icon set (Assets.xcassets).
APP_DISPLAY_NAME = Codex Anywhere
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

#include? "Local.xcconfig"
