#!/usr/bin/env bash
set -euxo pipefail

TEMP_DIR="$(mktemp -d)"

APP_VERSION="26.924.22138"
curl -o "$TEMP_DIR/file.zip" "https://persistent.oaistatic.com/codex-app-prod/ChatGPT-darwin-arm64-$APP_VERSION.zip"

HOSTED_CODEX_APP_ZIP="$TEMP_DIR/file.zip" bash ./scripts/prepare_asar
# Our own copy of the MCP App sandbox shell, served on PORT+1 (plugin pages).
node ./scripts/mirror_mcp_sandbox.mjs || echo "warning: MCP App sandbox shell not mirrored; plugin pages stay blank until scripts/mirror_mcp_sandbox.mjs succeeds"

rm -rf "$TEMP_DIR"
